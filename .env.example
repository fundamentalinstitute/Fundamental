# ── Supabase ──────────────────────────────────────────────────────────
# Copy EXACTLY from Supabase dashboard → Project Settings → Data API →
# Project URL. The ref is 20 characters — a typo makes every form fail.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-20-CHAR-PROJECT-REF.supabase.co

# Publishable (anon) key — safe for the browser. Used by /api/leads as a
# fallback write key: the migration grants INSERT-only RLS policies, so this
# key can submit forms but never read, update, or delete anything.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role key (Supabase dashboard → Settings → API). Server-side ONLY —
# never prefix with NEXT_PUBLIC_. Preferred write key when present.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications (Gmail SMTP + Nodemailer, same as AP site) ───
# Server-side ONLY. SMTP_PASS is a Gmail App Password
# (Google Account → Security → 2-Step Verification → App passwords),
# NOT the account password.
SMTP_USER=
SMTP_PASS=
# Recipient(s) for form-submission notifications; comma-separate several.
NOTIFY_ADMIN_EMAIL=

# ── WhatsApp ──────────────────────────────────────────────────────────
# The official short link (opens the Fundamentals Institute chat). Used as the
# fallback destination when no number is configured — short links can't carry
# a prefilled message.
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.link/b4aw8s

# The phone number BEHIND wa.link/b4aw8s, digits only with country code
# (e.g. 9198XXXXXXXX). Required for prefilled messages via wa.me.
NEXT_PUBLIC_WHATSAPP_NUMBER=
